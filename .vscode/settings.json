{
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "hide-files.files": [],
    //set tailwind as language format for only main.css
    "[css]": {
        "editor.defaultFormatter": "bradlc.vscode-tailwindcss"
    },
}