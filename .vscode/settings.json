{
    "editor.tabSize": 4,
    "editor.detectIndentation": false,

    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },

    "hide-files.files": [],

    "[css]": {
        "editor.defaultFormatter": "bradlc.vscode-tailwindcss",
        "editor.formatOnSave": true
    }
}